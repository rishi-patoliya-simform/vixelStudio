{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@modules": ["src/modules/index.ts"],
      "@modules/*": ["src/modules/*"]
    },
    "target": "esnext",
    "lib": [
      "es2018",
      "es2019",
      "es2020",
      "es2023"
    ],
    "jsx": "react-native",
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "typeRoots": [
      "src/types",
      "node_modules/@types"
    ],
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "importHelpers": true,
    "ignoreDeprecations": "5.0",
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true,
    // Set `sourceRoot` to  "/" to strip the build path prefix from
    // generated source code references. This will improve issue grouping in Sentry.
    "sourceRoot": "/"
  },
  "include": ["src", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "filesGlob": ["typings/index.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "withCustomSigning.js"
  ],
  "extends": "expo/tsconfig.base"
}